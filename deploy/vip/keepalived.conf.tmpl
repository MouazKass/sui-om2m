# keepalived.conf - cluster VIP for the ESP sensors (generated by
# deploy/vip/install_vip.sh from deploy/inventory.tsv; do not edit on the Pi).
#
# The ESPs connect to ONE address, @VIP@ on the Wi-Fi. It sits on the
# cluster's current on-chain PARENT (the most trusted node, the one that stores
# the readings) and follows it when the parent changes:
#   * is_parent (weight +100) succeeds only on the parent, read from the chain
#     by the ESP bridge (parent.json), so the parent always outranks the
#     others (base priorities are @PRIO_RANGE@, all below 100 apart);
#   * esp_ready (no weight = hard failure) puts a node in FAULT if its Wi-Fi,
#     MQTT broker or ESP bridge is down. Then the highest-priority healthy
#     non-parent holds the VIP until the parent is healthy again.
# Preemption is on (the VIP must move to a new parent); preempt_delay damps
# flapping while the nodes' chain polls catch up with a parent change.
#
# VRRP adverts go by UNICAST over the wired LAN (eth0), which is stable and not
# subject to Wi-Fi multicast filtering; the VIP itself lives on wlan0.

global_defs {
    router_id @NODE@
    script_user root
    enable_script_security
    vrrp_garp_master_refresh 30
}

vrrp_script esp_ready {
    script "/etc/keepalived/esp_ready.sh"
    interval 2
    timeout 2
    fall 2
    rise 2
}

vrrp_script is_parent {
    script "/etc/keepalived/is_parent.sh"
    interval 2
    timeout 2
    fall 1
    rise 1
    weight 100
}

vrrp_instance ESP_VIP {
    state BACKUP
    interface eth0
    virtual_router_id @VRID@
    priority @PRIO@
    preempt_delay 5
    advert_int 1
    unicast_src_ip @SELF_IP@
    unicast_peer {
@PEERS@
    }
    virtual_ipaddress {
        @VIP@/24 dev wlan0
    }
    track_interface {
        wlan0
    }
    track_script {
        esp_ready
        is_parent
    }
    garp_master_delay 1
    garp_master_repeat 3
}
