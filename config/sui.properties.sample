# Sui Access Control plugin runtime config.
# Drop this file at $OM2M_HOME/configuration/sui.properties on each
# Raspberry Pi after running the deploy script.

# --- Sui CLI ---
# Absolute path to the `sui` binary on the Pi.
sui.cli.path=/usr/local/bin/sui

# Active environment from ~/.sui/sui_config/client.yaml
sui.env=testnet

# --- Package + shared object IDs (filled in after `sui client publish`) ---
sui.package.id=0xPLACEHOLDER_PACKAGE_ID
sui.identity.registry.id=0xPLACEHOLDER_IDENTITY_REGISTRY
sui.trust.registry.id=0xPLACEHOLDER_TRUST_REGISTRY
sui.policy.registry.id=0xPLACEHOLDER_POLICY_REGISTRY
sui.audit.trail.id=0xPLACEHOLDER_AUDIT_TRAIL
# Failover cluster object ID (empty disables failover on this node).
sui.failover.cluster.id=0xPLACEHOLDER_CLUSTER

# Sui Clock object — always 0x6.
sui.clock.id=0x6

# --- This node ---
# Sui address of this CSE's keypair (from `sui client active-address`).
sui.node.address=0xPLACEHOLDER_THIS_NODE

# Gas budget per PTB submission, in MIST (1 SUI = 1e9 MIST).
sui.gas.budget=20000000

# --- MQTT (matches the existing testbed broker) ---
mqtt.broker.url=tcp://10.25.96.200:1883

# --- Failover timings ---
failover.heartbeat.period.ms=5000
failover.heartbeat.timeout.ms=15000
failover.lease.anchor.period.ms=600000

# --- On-chain endpoint ---
# Sui GraphQL endpoint used for ALL on-chain reads (objects, coins, gas price,
# dynamic fields), read-only simulation (identity::is_registered,
# trust::score_of) and transaction execution. Public fullnodes have
# deprecated JSON-RPC, so sui.rpc.url is no longer used for these calls.
# If unset: derived from sui.rpc.url for the public fullnode hosts
# (fullnode.<net>.sui.io -> graphql.<net>.sui.io/graphql), else this default.
sui.graphql.url=https://graphql.testnet.sui.io/graphql

# Legacy fullnode JSON-RPC URL. Kept for compatibility only.
#sui.rpc.url=https://fullnode.testnet.sui.io:443

# Use native BCS+GraphQL (formerly JSON-RPC) for the DAS access PTB instead of shelling out to
# the sui CLI. ~2.5x faster and reports precise on-chain Move abort codes on
# DENY (vs the opaque "sui CLI exited 1"). See NATIVE_DAS_EVIDENCE.md.
sui.use.native.rpc=true

# --- Trust engine on-chain write discipline (must match move/sources/trust.move) ---
# Largest score change one write may carry; must equal trust::MAX_DELTA (15).
# Bigger changes are applied as several capped steps.
#trust.max.delta=15
# Minimum gap (ms) between two writes for the same target. trust.move aborts a
# write <60000 ms after the previous one (E_RATE_LIMITED); +5 s for clock skew.
#trust.min.write.interval.ms=65000
# How often (ms) the submitter re-writes a live target to re-anchor on-chain
# decay (1 point per full day without a write). Must stay under one day.
#trust.reattest.period.ms=43200000
