// evolution.move
//
// Layer 3 of slide 8: Self-Evolving Living Tokens.
//
// This module is the only one in the framework that touches the two
// Sui-exclusive features called out in slide 7:
//
//   * Dynamic Fields — we attach a `BehaviourLog` and a `Tier` field to
//     each CapToken at runtime, after mint. The token's struct doesn't
//     need to know about them; they're added later without redeploying.
//
//   * Transfer-to-Object — sub-capability child objects are transferred
//     to the token itself, making them owned by the token rather than
//     by an address. When the parent token is revoked the children
//     become unreachable.
//
// Evolution mutates a token's `allowed_ops` via the package-private
// `grant_ops` / `revoke_ops` helpers in cap_token.move. The trust score
// is the input signal; the output is a wider or narrower op-set, plus
// optionally a child SubCapability for the highest tier.

module om2m_access::evolution {
    use std::string::String;
    use sui::object::{Self, UID};
    use sui::tx_context::{Self, TxContext};
    use sui::transfer;
    use sui::clock::{Self, Clock};
    use sui::dynamic_field as df;
    use sui::event;

    use om2m_access::cap_token::{Self, CapToken};
    use om2m_access::trust::{Self, TrustRegistry};

    // === Errors ===
    const E_INSUFFICIENT_TRUST: u64 = 1;
    const E_NO_TIER_FIELD: u64 = 2;

    // === Tier thresholds (trust score -> tier) ===
    // 0..=24   -> 0 (probation) : OP_READ
    // 25..=49  -> 1 (basic)     : OP_READ
    // 50..=74  -> 2 (standard)  : OP_READ | OP_WRITE
    // 75..=89  -> 3 (trusted)   : OP_READ | OP_WRITE | OP_DELETE
    // 90..=100 -> 4 (custodian) : OP_READ | OP_WRITE | OP_DELETE | OP_ADMIN
    const TIER_PROBATION: u8 = 0;
    const TIER_BASIC:     u8 = 1;
    const TIER_STANDARD:  u8 = 2;
    const TIER_TRUSTED:   u8 = 3;
    const TIER_CUSTODIAN: u8 = 4;

    // === Dynamic field keys ===
    // Using zero-sized phantom structs as keys keeps the on-chain
    // representation minimal.
    public struct TierKey       has copy, drop, store {}
    public struct BehaviourKey  has copy, drop, store {}

    // === Behaviour log (attached as a dynamic field) ===
    public struct BehaviourLog has store, drop {
        promotions: u64,
        demotions:  u64,
        last_evolved_ms: u64,
    }

    // === Sub-capability (child object, transferred to the token) ===
    // Holds finer-grained context for the custodian tier (slide 8
    // Layer 3 "tokens adapt permissions autonomously").
    public struct SubCapability has key, store {
        id: UID,
        granted_for: String, // free-form scope label
        granted_at_ms: u64,
    }

    // === Events ===
    public struct TierChanged has copy, drop {
        token_id: address,
        old_tier: u8,
        new_tier: u8,
        trust_score: u64,
        timestamp_ms: u64,
    }

    public struct SubCapabilityAttached has copy, drop {
        token_id: address,
        sub_cap_id: address,
        scope: String,
    }

    // === Initialise evolution state on an existing token ===
    // Called once, right after the IN-CSE mints a token. Bootstraps the
    // dynamic fields. Cannot be folded into `mint` because Layer 3 is
    // intentionally orthogonal — a deployment that doesn't want
    // evolution can simply never call this.
    public entry fun bootstrap(
        token: &mut CapToken,
        clock: &Clock,
    ) {
        let now = clock::timestamp_ms(clock);
        let uid = cap_token::token_uid_mut(token);

        if (!df::exists_(uid, TierKey {})) {
            df::add(uid, TierKey {}, TIER_BASIC);
        };
        if (!df::exists_(uid, BehaviourKey {})) {
            df::add(uid, BehaviourKey {}, BehaviourLog {
                promotions: 0,
                demotions:  0,
                last_evolved_ms: now,
            });
        };
    }

    // === Evolve based on current trust score ===
    // Reads the requester's trust score, computes the target tier,
    // mutates the token's allowed_ops bitmask to match, and records the
    // change. No-op if the tier hasn't changed.
    public entry fun evolve(
        token: &mut CapToken,
        trust_reg: &TrustRegistry,
        node_addr: address,
        clock: &Clock,
    ) {
        let score = trust::score_of(trust_reg, node_addr, clock);
        let target_tier = tier_for(score);

        let token_addr = cap_token::token_address(token);
        let uid = cap_token::token_uid_mut(token);

        assert!(df::exists_(uid, TierKey {}), E_NO_TIER_FIELD);
        let current_tier: &mut u8 = df::borrow_mut(uid, TierKey {});
        let old_tier = *current_tier;

        if (old_tier == target_tier) return;

        // Compute target op-mask from target tier.
        let target_ops = ops_for_tier(target_tier);
        let current_ops = cap_token::allowed_ops(token);

        // Promote: grant the bits in target that aren't in current.
        // Demote:  revoke the bits in current that aren't in target.
        if (target_ops != current_ops) {
            // The xor gives bits that differ; bitwise-and with target
            // isolates the bits to grant.
            let to_grant  = target_ops & (255 - current_ops);
            let to_revoke = current_ops & (255 - target_ops);
            if (to_grant != 0)  cap_token::grant_ops(token,  to_grant);
            if (to_revoke != 0) cap_token::revoke_ops(token, to_revoke);
        };

        // Update tier field.
        *current_tier = target_tier;

        // Update behaviour log.
        let now = clock::timestamp_ms(clock);
        let log: &mut BehaviourLog = df::borrow_mut(uid, BehaviourKey {});
        if (target_tier > old_tier) {
            log.promotions = log.promotions + 1;
        } else {
            log.demotions = log.demotions + 1;
        };
        log.last_evolved_ms = now;

        event::emit(TierChanged {
            token_id: token_addr,
            old_tier,
            new_tier: target_tier,
            trust_score: score,
            timestamp_ms: now,
        });
    }

    // === Attach a child SubCapability via Transfer-to-Object ===
    // Sui-exclusive: the child's owner is the *token object*, not an
    // address. Revoking the parent token makes the child unreachable.
    public entry fun attach_sub_capability(
        token: &mut CapToken,
        scope: String,
        clock: &Clock,
        ctx: &mut TxContext,
    ) {
        let now = clock::timestamp_ms(clock);
        let sub = SubCapability {
            id: object::new(ctx),
            granted_for: scope,
            granted_at_ms: now,
        };
        let sub_addr = object::uid_to_address(&sub.id);
        let token_addr = cap_token::token_address(token);

        event::emit(SubCapabilityAttached {
            token_id: token_addr,
            sub_cap_id: sub_addr,
            scope: sub.granted_for,
        });

        // The Transfer-to-Object primitive.
        transfer::public_transfer(sub, token_addr);
    }

    // === Tier table ===
    fun tier_for(score: u64): u8 {
        if (score >= 90) TIER_CUSTODIAN
        else if (score >= 75) TIER_TRUSTED
        else if (score >= 50) TIER_STANDARD
        else if (score >= 25) TIER_BASIC
        else TIER_PROBATION
    }

    fun ops_for_tier(tier: u8): u8 {
        let read   = cap_token::op_read();
        let write  = cap_token::op_write();
        let delete = cap_token::op_delete();
        let admin  = cap_token::op_admin();

        if (tier == TIER_PROBATION) read
        else if (tier == TIER_BASIC) read
        else if (tier == TIER_STANDARD) read | write
        else if (tier == TIER_TRUSTED) read | write | delete
        else read | write | delete | admin
    }

    // === Tier constants for external callers ===
    public fun tier_probation(): u8 { TIER_PROBATION }
    public fun tier_basic():     u8 { TIER_BASIC }
    public fun tier_standard():  u8 { TIER_STANDARD }
    public fun tier_trusted():   u8 { TIER_TRUSTED }
    public fun tier_custodian(): u8 { TIER_CUSTODIAN }
}
